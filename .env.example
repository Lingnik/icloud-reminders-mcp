# icloud-reminders-mcp — example environment configuration
#
# Copy to `.env` and fill in real values, OR (preferred on this host) keep the
# real values in 1Password and inject them at runtime with:
#
#     op run --env-file ~/.secrets -- icloud-reminders-mcp
#
# where ~/.secrets contains op:// references, e.g.:
#     ICLOUD_USERNAME="op://kalipi/icloud-reminders-mcp/username"
#     ICLOUD_APP_PASSWORD="op://kalipi/icloud-reminders-mcp/password"
#
# NEVER commit a real .env — it is gitignored. Only this .example is tracked.

# --- Required ---------------------------------------------------------------

# Apple ID email address.
ICLOUD_USERNAME="you@example.com"

# App-specific password generated at https://appleid.apple.com (Sign-In & Security
# > App-Specific Passwords). Format: xxxx-xxxx-xxxx-xxxx. NOT your Apple ID password.
# Revoke it there at any time as an instant kill switch.
ICLOUD_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# --- Optional ---------------------------------------------------------------

# Override the CalDAV root. Leave unset to use https://caldav.icloud.com/ and let
# the library auto-discover your account's sharded host (pNN-caldav.icloud.com).
#ICLOUD_CALDAV_URL="https://caldav.icloud.com/"

# Enable the destructive delete_reminder tool. Default false. Even when true,
# delete_reminder still requires an explicit `confirm: true` argument per call.
REMINDERS_ALLOW_DELETE="false"

# Restrict the server to specific reminder lists (comma-separated display names).
# Empty/unset = all task lists are visible. Names are matched case-insensitively.
#REMINDERS_LIST_ALLOWLIST="Family TODOs,Groceries"
